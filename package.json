{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker nextjs-postgresql-template-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.1.5",
    "@neondatabase/serverless": "^1.2.1",
    "@vinext/cloudflare": "^1.3.4",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.2",
    "pg": "8.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tsx": "^4.23.15",
    "vinext": "^1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.16",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-beta.31",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.23",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "type": "module"
}
